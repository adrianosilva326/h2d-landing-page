DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Route-specific static HTML must be served before the SPA fallback so
  # crawlers receive the correct metadata without executing JavaScript.
  RewriteRule ^portfolio/?$ portfolio/index.html [L]
  RewriteRule ^portfolio-pdf/?$ portfolio-pdf/index.html [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
